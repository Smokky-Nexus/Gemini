 * Python SDK; keep all three in sync. Tests pin the literals on each side so
 * one-sided drift fails CI.
 */
declare const MIN_PREVIEW_PORT = 1024;
declare const MAX_PREVIEW_PORT = 65535;
declare const RESERVED_PREVIEW_PORT = 49983;
